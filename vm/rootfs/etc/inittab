# PurrOS /etc/inittab

::sysinit:/sbin/openrc sysinit
::sysinit:/sbin/openrc boot
::wait:/sbin/openrc default

# tty1 is the PurrOS screen: purr logs in by itself and ~/.bash_profile starts
# /opt/purros/session.sh.
tty1::respawn:/sbin/agetty --autologin purr --noclear --skip-login --noissue --nohostname tty1 linux

# tty2 is a plain login (ctrl+alt+f2) for repairs.
tty2::respawn:/sbin/getty 38400 tty2

# Serial port: debug shell for the host (purros --console). Kernel and service
# messages also land here instead of on the screen.
ttyS0::respawn:/sbin/agetty --autologin purr -L 115200 ttyS0 vt100

::ctrlaltdel:/sbin/reboot
::shutdown:/sbin/openrc shutdown
